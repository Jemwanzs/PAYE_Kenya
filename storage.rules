rules_version = '2';

// Direct translation of the business-logos bucket policies in
// supabase/schema.sql. Public read (the bucket was public=true with no
// SELECT policy needed -- logos are printed via plain <img> tags with
// no auth header); writes scoped to the uploader's own folder (mirrors
// business_logos_owner_write/update/delete's
// storage.foldername(name)[1] = auth.uid() check).
service firebase.storage {
  match /b/{bucket}/o {
    match /business-logos/{ownerUid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
